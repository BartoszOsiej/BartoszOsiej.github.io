---
permalink: /blog/index.json
---
[
{%- assign posts = site.content | where: "published", true | sort: "date" | reverse -%}
{%- for post in posts -%}
  {
    "slug": {{ post.path | split: "/" | last | split: "." | first | jsonify }},
    "title": {{ post.title | jsonify }},
    "tldr": {{ post.tldr | jsonify }},
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "tags": [{% for t in post.tags %}{{ t | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %}],
    "html": {{ post.content | jsonify }},
    "words": {{ post.content | strip_html | split: " " | size }},
    "source": {{ post.path | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
